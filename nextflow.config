
/*
========================================================================================
  Nextflow config file
========================================================================================
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// One id names all of a run's artifacts - nextflow log (nextflow-<RUN_ID>.log),
// execution trace (execution_trace-<RUN_ID>.txt) and execution report
// (execution_report-<RUN_ID>.html) - so they can be matched up at a glance.
// The run wrapper computes and exports RUN_ID (label/study_project_cohort plus a
// YYYYMMDDTHHMMSS timestamp); direct `nextflow run` invocations fall back to a
// bare timestamp in the same format.
def run_id = System.getenv('RUN_ID') ?: new java.util.Date().format("yyyyMMdd'T'HHmmss")

// Where this run's execution trace goes. The run wrapper exports TRACE_DIR; System.getenv
// (rather than a "${TRACE_DIR}" interpolation) is used deliberately - an unset variable in a
// Nextflow config string silently becomes the literal '[:]', whereas getenv returns null and
// falls back cleanly here.
def trace_dir  = System.getenv('TRACE_DIR') ?: 'results/pipeline_info'
def trace_path = "${trace_dir}/execution_trace-${run_id}.txt"

// Global default params, used in configs
params {

    // Boilerplate options
    outdir                     = './results'
    tracedir                   = "${params.outdir}/pipeline_info"
    publish_dir_mode           = 'copy'

    // Max requirements
    max_memory                 = '128.GB'
    max_cpus                   = 16
    max_time                   = '240.h'

    // Study identifier used as a prefix on all merged tables and summary plot
    // filenames. Must be set per run (see validation in main.nf).
    study_id                   = null

    // Input mode - set exactly one of the following.
    //   fastq_path: glob of paired FASTQs, matched to PRIDs via sample_metadata.
    //   bam_path:   glob matching indexed BAMs and their .bai (e.g. "/path/*.bam*");
    //               patient_id is derived from the BAM filename.
    fastq_path                 = null
    bam_path                   = null

    // Sample universe - optional TSV listing every sample that belongs to the study,
    // used to restrict which of the files matched by the input glob are processed.
    sample_universe            = null

    // Subcohorts - map of subcohort name to config with sample_list path
    // Example:
    // subcohorts = [
    //     "cohort_a": [sample_list: "/path/to/cohort_a_samples.tsv"],
    //     "cohort_b": [sample_list: "/path/to/cohort_b_samples.tsv"],
    // ]
    subcohorts                 = [:]


    // Skip status reporting for stub/test runs (accepts true/false/1/0).
    // `-stub-run` on the CLI (workflow.stubRun) is also honoured, so this flag
    // is only needed where that is unavailable.
    is_stub                    = false

    // Sample metadata TSV mapping Sanger ids to PRIDs (sample / sample_supplier_name).
    // Only used with fastq_path; ignored in bam_path mode.
    sample_metadata            = null

    // Run reporting is deliberately kept out of the workflow's params: it is gated by
    // two env-var opt-ins exported by the run wrapper (see assets/run_rna_fusions.sh)
    // and lib/Utils.groovy reads everything it needs (COHORT_SLUG,
    // SAMPLE_LIST_VERSION_FILE, SELF_DESCRIBING_API, SLACK_WEBHOOK_URL, RUN_ID)
    // straight from the environment in the onComplete handler:
    //   DERMATLAS_WEBSITE_LOGGING     - record the run via `dermatlas-http cohort
    //                                   analysis-log` (>= 0.6.1).
    //   DERMATLAS_SLACK_NOTIFICATIONS - post a Slack message on completion.
    // The one reporting value that is a param is this pipeline's own slug in the
    // analysis log - pipeline-owned metadata, like the manifest version.
    analysis_pipeline_slug     = 'rnafusion_pipe'

    // Path of this run's execution trace. Assigned from the same value as trace.file below,
    // so the two can never drift; read by the onComplete handler and attached to the
    // analysis-log record (--nextflow-performance) when website logging is opted in.
    trace_file                 = trace_path

}

profiles {
    secure_lustre {
        process.executor = 'local'
        
        params {
            ctat_lib = "/lustre/scratch124/casm/team78pipelines/sci_ref/human/GRCh38_full_analysis_set_plus_decoy_hla/star-fusion/GRCh38_gencode_v37_CTAT_lib_Mar012021.plug-n-play/ctat_genome_lib_build_dir"
        }

        docker {
        enabled = true
        runOptions = '-u $(id -u):$(id -g)'
        }

        singularity {
            enabled    = false
            autoMounts = false
        }
    }

    farm22 {
        process.executor = 'lsf'
        singularity.runOptions = "--bind /lustre"

        process {
            withName: 'STAR_FUSION' {
                memory = '60.GB'
                cpus = 16
                module = "star-fusion/1.10.1"
                }
        withName: 'BAM_TO_FASTQ' {
            cpus = 4
            memory = '8.GB'
            time = '4h'
            module = "samtools-1.19/python-3.12.0"
        }
        withName: FILTER_AND_MERGE_SAMPLES {
            cpus = 1
            memory = '4 GB'
            time = '1h'
        }
        withName: SUMMARY_PLOTS_AND_TABLES {
            cpus = 1
            memory = '4 GB'
            time = '1h'
        }
        
        }
    // Site reference data only. Anything project-shaped (output locations, metadata and
    // sample-list paths) belongs in the run's own -c config, driven by the project
    // source_me.sh - see assets/rna_fusions.config.
    params {
        ctat_lib = "/lustre/scratch127/casm/projects/dermatlas/references/star_fusion/GRCh38_gencode_v37_CTAT_lib_Mar012021.plug-n-play/ctat_genome_lib_build_dir"
        }



        docker {
        enabled = false
        }
        singularity {
            enabled    = true
            autoMounts = true
            cacheDir = '/lustre/scratch127/casm/projects/dermatlas/singularity_images'
            registry = 'gitlab-registry.internal.sanger.ac.uk'
            }
        executor {
            name = 'lsf'
            perJobMemLimit = true
            poolSize = 4
            submitRateLimit = '5 sec'
            killBatchSize = 50
        }
        }
}



report {
    enabled = true
    file    = "${params.tracedir}/execution_report-${run_id}.html"
}

trace {
    enabled   = true
    file      = trace_path
    overwrite = false
}


manifest {
    name            = 'dermatlas_rnafusions_nf'
    author          = 'Jamie Billington, Martin Del Castillo Velasco-Herrera, Ian Vermes'
    homePage        = 'https://github.com/team113sanger/dermatlas_rnafusions_nf'
    description     = 'Dermatlas RNAfusion analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.04.5'
    version         = '0.4.11'
    defaultBranch   = 'develop'
}

// Function to check maximum resources
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max memory '${params.max_memory}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "   ### ERROR ###   Max time '${params.max_time}' is not valid! Using default value: $obj"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) {
            println "   ### ERROR ###   Max cpus '${params.max_cpus}' is not valid! Using default value: $obj"
            return obj
        }
    }
}