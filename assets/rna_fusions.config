params {
    // Every projectify location below comes from the project source_me.sh.
    // run_rna_fusions.sh checks these are exported before nextflow is launched -
    // an unset variable is not an error to the config parser, it silently becomes
    // the literal '[:]', so the guard in the wrapper is what catches it.
    bam_path = "${BAMS_DIR}/**bam{,.bai}"
    outdir   = "${ANALYSIS_DIR}/star-fusion"

    // Cohort-independent, pipeline-owned: not a source_me.sh concern.
    ctat_lib = "/lustre/scratch127/casm/projects/dermatlas/references/star_fusion/GRCh38_gencode_v37_CTAT_lib_Mar012021.plug-n-play/ctat_genome_lib_build_dir"

    study_id = "${STUDY}"
    all_samples = "${RNA_SAMPLE_QC_MANIFEST}"

    // Define subcohorts - each key is the subcohort name (used as study_id in outputs)
    // Each value must contain a sample_list path pointing to a file with sample IDs (one per line).
    // The sample lists are generated and versioned by dermanager, so it owns their paths.
    subcohorts = [
        "one_per_patient": [
            sample_list: "${RNA_SAMPLE_LIST_ONE_PER_PATIENT}"
        ],
        "final_decision": [
            sample_list: "${RNA_SAMPLE_LIST_FINAL_DECISION}"
        ]
    ]

    // Run reporting needs no params here: it is gated by the DERMATLAS_WEBSITE_LOGGING /
    // DERMATLAS_SLACK_NOTIFICATIONS env vars exported by run_rna_fusions.sh, and the
    // pipeline's onComplete handler reads the payload values (COHORT_SLUG,
    // SAMPLE_LIST_VERSION_FILE, SELF_DESCRIBING_API, SLACK_WEBHOOK_URL) straight from
    // the environment.
}

// nextflow.config resolves params.tracedir eagerly against the default outdir, so the
// execution report would otherwise land in ./results/pipeline_info relative to the
// launch directory. This block is parsed last, so it wins. RUN_ID (exported by the
// wrapper) keeps the report name in step with the nextflow log and execution trace.
report {
    file = "${ANALYSIS_DIR}/star-fusion/pipeline_info/execution_report-${System.getenv('RUN_ID') ?: new Date().format("yyyyMMdd'T'HHmmss")}.html"
}
