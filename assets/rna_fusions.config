params {
    bam_path = "${PROJECT_DIR}/bam/**bam{,.bai}"
    outdir = "${ANALYSIS_DIR}/star-fusion"
    ctat_lib = "/lustre/scratch127/casm/projects/dermatlas/references/star_fusion/GRCh38_gencode_v37_CTAT_lib_Mar012021.plug-n-play/ctat_genome_lib_build_dir"
    study_id = "${STUDY}"

    // Define subcohorts - each key is the subcohort name (used as study_id in outputs)
    // Each value must contain a sample_list path pointing to a file with sample IDs (one per line)
    subcohorts = [
        "one_per_patient": [
            sample_list: "${PROJECT_DIR}/metadata/${STUDY}_${PROJECT}_rna-analysed_one_samp_ppat_sampnames.tsv"
        ],
        "final_decision": [
            sample_list: "${PROJECT_DIR}/metadata/${STUDY}_${PROJECT}_rna-analysed_final_decision_sampnames.tsv"
        ]
    ]
    analysis_log_api_url       = "https://team113.sanger.ac.uk/api/versioned-cohort-analysis-log"
    sample_list_version = "${PROJECT_DIR}/metadata/version"
    analysis_pipeline_slug = "rnafusion_pipe"
    cohort_slug = "${COHORT_SLUG}"

    // Optional. If set, Slack webhook URL to send notifications on pipeline completion (success or failure).
    slack_webhook_url = ${"SLACK_WEBHOOK_URL}

}