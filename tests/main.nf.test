nextflow_pipeline {

    name "Test Workflow main.nf"
    script "main.nf"

    test("Should run without failures") {

        when {
            params {
                load("$baseDir/tests/testdata/test_params.json")
            }
        }

        then {
            assert workflow.success
        }

    }

    test("Should process only the samples listed in the sample universe") {

        options "-stub"

        when {
            params {
                load("$baseDir/tests/testdata/test_params.json")
                sample_universe = "$baseDir/tests/testdata/sample_universe.tsv"
            }
        }

        then {
            assert workflow.success
            // PD1002 is not in the universe, so only PD1001 reaches STAR_FUSION.
            assert workflow.trace.tasks().findAll { it.name.contains("STAR_FUSION") }.size() == 1
        }

    }

}
